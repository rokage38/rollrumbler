# All optional. Leave unset to use the free public PeerJS signalling server.
# Self-hosted PeerJS signalling server (npx peerjs --port 9000 --path /)
# VITE_PEER_HOST=peer.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true
# TURN relay for phones on strict carrier networks (for example a free Metered.ca account)
# VITE_TURN_URL=turn:a.relay.metered.ca:80,turn:a.relay.metered.ca:443
# VITE_TURN_USER=...
# VITE_TURN_PASS=...
